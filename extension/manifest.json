{
  "manifest_version": 3,
  "name": "微博 Evernote 本機收件匣",
  "version": "1.3.0",
  "description": "將微博乾淨文字、時間、原始連結、圖片與可下載影片先保存到本機，再增量匯入 Evernote。",
  "permissions": ["storage"],
  "host_permissions": [
    "https://weibo.com/*",
    "https://www.weibo.com/*",
    "http://127.0.0.1:38419/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://weibo.com/*", "https://www.weibo.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "微博 Evernote 本機收件匣",
    "default_popup": "popup.html"
  }
}
